{
  "name": "myzel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "schema:templates": "vitest run -u src/data/mock/templates.test.ts",
    "schema:export": "vitest run -u src/shared/export.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:e2e && npm run test:smoke",
    "db:first-admin": "tsx --env-file=.env server/db/firstAdmin.ts",
    "db:push": "tsx --env-file=.env server/db/push.ts",
    "db:import-members": "tsx --env-file=.env server/db/importMembers.ts",
    "dev:backend": "vite --mode backend",
    "check:integrity": "tsx --env-file=.env server/integrity/checks.ts",
    "build:smoke": "vite build --mode backend --outDir dist-smoke",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "telegram:webhook": "tsx --env-file=.env server/p2/setupTelegram.ts",
    "db:seed-templates": "tsx --env-file=.env server/p4/seedTemplates.ts"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^10.0.1",
    "@netlify/functions": "^6.0.3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}

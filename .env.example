# Myzel – Umgebungsvariablen. Kopieren nach .env und ausfüllen; .env kommt nie ins Repo.
# In Netlify dieselben Namen anlegen (Site configuration › Environment variables), geheime Werte als „secret“.
# VITE_… landet im Browser-Code und ist damit öffentlich – dort nie etwas Geheimes eintragen.

# ── App (öffentlich) ────────────────────────────────────────────────────────
# Project Settings › API: Projekt-URL und anon bzw. publishable key
VITE_SUPABASE_URL=https://wyfsorojbcijkedlnmji.supabase.co
VITE_SUPABASE_ANON_KEY=
# optional: Link „Finanzen · MeinVerein“; leer = Startseite von MeinVerein
VITE_MEINVEREIN_URL=

# ── Server-Funktionen (geheim) ──────────────────────────────────────────────
# Project Settings › API: service_role bzw. secret key – nur für die Netlify Functions
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings › Database › Connection string, Modus „Transaction pooler“ (Port 6543), mit Datenbank-Passwort
DATABASE_URL=

# ── Phase 2: Erinnerungen (geheim) ──────────────────────────────────────────
# Web-Push: Schlüsselpaar mit `npx web-push generate-vapid-keys`; der öffentliche Teil geht auch an die App
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
# Telegram: Bot-Token von @BotFather und ein frei gewähltes Secret für den Webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Joblauf alle 15 Minuten über cron-job.org: geheimer Schlüssel im Aufruf
CRON_SECRET=

# ── Phase 5: Drive ──────────────────────────────────────────────────────────
# ID aus drive.google.com/drive/folders/<ID> (nicht geheim)
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# optional, kommagetrennt: Unterordner, die nicht erscheinen sollen
GOOGLE_DRIVE_EXCLUDED_FOLDER_IDS=
# Schlüssel des Dienstkontos als JSON in einer Zeile (geheim)
GOOGLE_SERVICE_ACCOUNT_JSON=
